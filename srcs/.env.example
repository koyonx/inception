# =============================================================================
#  Inception - environment variables (mandatory part)
#  This file is a TEMPLATE. `make setup` copies it to srcs/.env and replaces
#  __LOGIN__ with your 42 login. srcs/.env is git-ignored.
#  NO PASSWORD HERE: every credential lives in ../secrets/ (docker secrets).
# =============================================================================

# ---- Host / domain ----------------------------------------------------------
LOGIN=__LOGIN__
DOMAIN_NAME=__LOGIN__.42.fr
DATA_PATH=/home/__LOGIN__/data

# ---- MariaDB ----------------------------------------------------------------
MYSQL_HOST=mariadb
MYSQL_PORT=3306
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user

# ---- WordPress --------------------------------------------------------------
WP_VERSION=6.7.1
WP_TITLE=Inception
WP_URL=https://__LOGIN__.42.fr

# Administrator (must NOT contain "admin" or "administrator")
WP_ADMIN_USER=chief_dreamer
WP_ADMIN_EMAIL=chief_dreamer@__LOGIN__.42.fr

# Second, non-privileged user
WP_USER=cobb
WP_USER_EMAIL=cobb@__LOGIN__.42.fr
WP_USER_ROLE=author
