# =============================================================================
#  Inception - environment variables
#  This file is a TEMPLATE. `make setup` copies it to srcs/.env and replaces
#  __LOGIN__ with your 42 login. srcs/.env is git-ignored.
#  NO PASSWORD HERE: every credential lives in ../secrets/ (docker secrets).
# =============================================================================

# ---- Host / domain ----------------------------------------------------------
LOGIN=__LOGIN__
DOMAIN_NAME=__LOGIN__.42.fr
DATA_PATH=/home/__LOGIN__/data

# ---- MariaDB ----------------------------------------------------------------
MYSQL_HOST=mariadb
MYSQL_PORT=3306
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user

# ---- WordPress --------------------------------------------------------------
WP_VERSION=6.7.1
WP_TITLE=Inception
WP_URL=https://__LOGIN__.42.fr

# Administrator (must NOT contain "admin" or "administrator")
WP_ADMIN_USER=chief_dreamer
WP_ADMIN_EMAIL=chief_dreamer@__LOGIN__.42.fr

# Second, non-privileged user
WP_USER=cobb
WP_USER_EMAIL=cobb@__LOGIN__.42.fr
WP_USER_ROLE=author

# ---- Bonus ------------------------------------------------------------------
# 1 = nginx also exposes /adminer/ and /static/ ; 0 = mandatory part only
ENABLE_BONUS=1

# Redis object cache
REDIS_HOST=redis
REDIS_PORT=6379

# FTP server (points to the WordPress volume)
FTP_USER=ftpuser
FTP_PASV_MIN=21000
FTP_PASV_MAX=21010
# Address the FTP client dials back in passive mode: the host running docker.
# Use the VM IP if you connect from outside the VM.
FTP_PASV_ADDRESS=127.0.0.1

# Automatic database backup (cron schedule, and how many dumps to keep)
BACKUP_SCHEDULE_HOUR=3
BACKUP_RETENTION_DAYS=7
